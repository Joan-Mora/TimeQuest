# Copia este archivo como .env (opcional) o define las variables en tu terminal / en Render.
# Node 20+ puede cargarlo con: node --env-file=.env src/server.js

# Puerto HTTP (Render lo define solo).
PORT=3000

# Clave del panel del moderador. OBLIGATORIA en producción (NODE_ENV=production).
# En desarrollo, si no la defines, se usa "profe123".
MODERATOR_KEY=cambia-esta-clave

# URL pública para el QR y el enlace de ingreso. En Render se toma sola de RENDER_EXTERNAL_URL.
# PUBLIC_URL=https://escape-room-estadistico.onrender.com

# Persistencia. Con REDIS_URL se usa Render Key Value; sin ella, archivos JSON en DATA_DIR.
# REDIS_URL=redis://red-xxxxx:6379
# DATA_DIR=.data

# Banco de preguntas inicial.
# QUESTIONS_FILE=data/questions.json

# Horas que se conserva una sala sin actividad.
# ROOM_TTL_HOURS=12

# Máximo de jugadores por sala.
# MAX_PLAYERS_PER_ROOM=80
